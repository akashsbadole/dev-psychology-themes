{
  "name": "Calm Teal Colorblind - Balance & Clarity",
  "type": "dark",
  "colors": {
    "editor.background": "#0d1a1a",
    "editor.foreground": "#e0f2f1",
    
    "panel.background": "#1a2a2a",
    "panel.border": "#26a69a30",
    "sideBar.background": "#1a2a2a",
    "sideBar.foreground": "#b2dfdb",
    
    "input.background": "#1d2d2d",
    "input.border": "#26a69a",
    "input.foreground": "#e0f2f1",
    "input.placeholderForeground": "#80cbc4",
    
    "button.background": "#26a69a",
    "button.foreground": "#eeeeee",
    "button.hoverBackground": "#4db6ac",
    "button.secondaryBackground": "#424242",
    "button.secondaryForeground": "#e0e0e0",
    "button.secondaryHoverBackground": "#616161",
    
    "widget.shadow": "#00000030",
    "dropdown.background": "#1d2d2d",
    "dropdown.border": "#26a69a",
    "dropdown.foreground": "#e0f2f1",
    
    "list.activeSelectionBackground": "#26a69a50",
    "list.activeSelectionForeground": "#e0f2f1",
    "list.hoverBackground": "#26a69a20",
    "list.inactiveSelectionBackground": "#26a69a30",
    
    "menu.background": "#1d2d2d",
    "menu.foreground": "#e0f2f1",
    "menu.selectionBackground": "#26a69a",
    "menu.selectionForeground": "#eeeeee",
    
    "notifications.background": "#1d2d2d",
    "notifications.foreground": "#e0f2f1",
    "notifications.border": "#26a69a",
    
    "editorCursor.foreground": "#4db6ac",
    "editor.lineHighlightBackground": "#00695c0A",
    "editor.selectionBackground": "#00897b60",
    "editor.selectionHighlightBackground": "#00897b20",
    "editor.findMatchBackground": "#ffeb3b40",
    "editor.findMatchHighlightBackground": "#ffeb3b20",
    "editor.wordHighlightBackground": "#00968830",
    "editor.wordHighlightStrongBackground": "#00968850",
    "editorIndentGuide.background": "#00695c30",
    "editorIndentGuide.activeBackground": "#4db6ac",
    "editorLineNumber.foreground": "#00796b",
    "editorLineNumber.activeForeground": "#b2dfdb",
    "editorGutter.background": "#0d1a1a",
    "editorGutter.modifiedBackground": "#ffeb3b",
    "editorGutter.addedBackground": "#4caf50",
    "editorGutter.deletedBackground": "#f44336",
    
    "editorBracketMatch.background": "#00897b40",
    "editorBracketMatch.border": "#4db6ac",
    "editorBracketHighlight.foreground1": "#ff6b9d",
    "editorBracketHighlight.foreground2": "#4fc3f7",
    "editorBracketHighlight.foreground3": "#81c784",
    "editorBracketHighlight.foreground4": "#ffb74d",
    "editorBracketHighlight.foreground5": "#ba68c8",
    "editorBracketHighlight.foreground6": "#26a69a",

    "activityBar.background": "#0f1e1e",
    "activityBar.foreground": "#b2dfdb",
    "activityBarBadge.background": "#009688",
    "activityBarBadge.foreground": "#eeeeee",

    "sideBarTitle.foreground": "#4db6ac",

    "statusBar.background": "#00796b",
    "statusBar.foreground": "#eeeeee",
    "statusBar.debuggingBackground": "#f44336",

    "tab.activeBackground": "#0d1a1a",
    "tab.activeForeground": "#e0f2f1",
    "tab.inactiveBackground": "#112020",
    "tab.activeBorder": "#4db6ac",

    "terminal.background": "#1d2a2a",
    "terminal.foreground": "#e8fafa",
    "terminal.ansiBlack": "#263238",
    "terminal.ansiRed": "#f44336",
    "terminal.ansiGreen": "#4caf50",
    "terminal.ansiYellow": "#ffeb3b",
    "terminal.ansiBlue": "#2196f3",
    "terminal.ansiMagenta": "#e91e63",
    "terminal.ansiCyan": "#00bcd4",
    "terminal.ansiWhite": "#eceff1",
    "terminal.ansiBrightBlack": "#37474f",
    "terminal.ansiBrightRed": "#ff5252",
    "terminal.ansiBrightGreen": "#69f0ae",
    "terminal.ansiBrightYellow": "#ffff00",
    "terminal.ansiBrightBlue": "#448aff",
    "terminal.ansiBrightMagenta": "#ff4081",
    "terminal.ansiBrightCyan": "#18ffff",
    "terminal.ansiBrightWhite": "#ffffff"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "comment.line",
        "comment.block"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#00796b"
      }
    },
    {
      "name": "Comment Documentation",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#80cbc4"
      }
    },

    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.other.using",
        "keyword.other.import"
      ],
      "settings": {
        "foreground": "#4db6ac",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Control Flow Keywords",
      "scope": [
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.exception",
        "keyword.control.trycatch"
      ],
      "settings": {
        "foreground": "#ff6b9d",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Storage Type",
      "scope": [
        "storage.type",
        "storage.modifier",
        "storage.type.class",
        "storage.type.function",
        "storage.type.interface"
      ],
      "settings": {
        "foreground": "#4fc3f7",
        "fontStyle": "bold"
      }
    },

    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.assignment"
      ],
      "settings": {
        "foreground": "#80cbc4"
      }
    },
    {
      "name": "Operator Word",
      "scope": [
        "keyword.operator.word",
        "keyword.operator.typeof",
        "keyword.operator.instanceof"
      ],
      "settings": {
        "foreground": "#ff6b9d"
      }
    },

    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.language.this",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#e0f2f1"
      }
    },
    {
      "name": "Variable Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member"
      ],
      "settings": {
        "foreground": "#a7ffeb"
      }
    },
    {
      "name": "Variable Parameter",
      "scope": [
        "variable.parameter",
        "variable.parameter.function"
      ],
      "settings": {
        "foreground": "#ffab40",
        "fontStyle": "italic"
      }
    },

    {
      "name": "Function Name",
      "scope": [
        "entity.name.function",
        "entity.name.method",
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#26a69a"
      }
    },
    {
      "name": "Function Declaration",
      "scope": [
        "meta.function entity.name.function",
        "meta.method entity.name.function"
      ],
      "settings": {
        "foreground": "#00897b",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Built-in Functions",
      "scope": [
        "support.function.builtin",
        "support.function.magic"
      ],
      "settings": {
        "foreground": "#4db6ac"
      }
    },

    {
      "name": "Class Name",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#ffab40",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Interface Name",
      "scope": [
        "entity.name.interface",
        "entity.name.type.interface"
      ],
      "settings": {
        "foreground": "#4fc3f7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Type Annotation",
      "scope": [
        "entity.name.type",
        "support.type",
        "meta.type.annotation"
      ],
      "settings": {
        "foreground": "#80cbc4"
      }
    },

    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.single",
        "string.quoted.double"
      ],
      "settings": {
        "foreground": "#a7ffeb"
      }
    },
    {
      "name": "Template String",
      "scope": [
        "string.template",
        "string.quoted.template"
      ],
      "settings": {
        "foreground": "#b2dfdb"
      }
    },
    {
      "name": "String Interpolation",
      "scope": [
        "string.interpolated",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#4fc3f7"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "string.regex"
      ],
      "settings": {
        "foreground": "#ff9800"
      }
    },

    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.decimal",
        "constant.numeric.hex",
        "constant.numeric.binary",
        "constant.numeric.octal"
      ],
      "settings": {
        "foreground": "#ffab40"
      }
    },
    {
      "name": "Boolean",
      "scope": [
        "constant.language.boolean",
        "constant.language.true",
        "constant.language.false"
      ],
      "settings": {
        "foreground": "#ff6b9d",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Null/Undefined",
      "scope": [
        "constant.language.null",
        "constant.language.undefined",
        "constant.language.none"
      ],
      "settings": {
        "foreground": "#f44336",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#ffab40",
        "fontStyle": "italic"
      }
    },

    
    {
      "name": "JS/TS - Import/Export",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.as"
      ],
      "settings": {
        "foreground": "#4fc3f7"
      }
    },
    {
      "name": "JS/TS - Async/Await",
      "scope": [
        "keyword.control.flow.async",
        "keyword.control.flow.await"
      ],
      "settings": {
        "foreground": "#ff6b9d",
        "fontStyle": "italic"
      }
    },
    {
      "name": "JS/TS - Destructuring",
      "scope": [
        "meta.object-binding-pattern-variable entity.name.binding",
        "meta.array-binding-pattern-variable entity.name.binding"
      ],
      "settings": {
        "foreground": "#a7ffeb"
      }
    },

    {
      "name": "Python - Self/Cls",
      "scope": [
        "variable.language.special.self.python",
        "variable.language.special.cls.python"
      ],
      "settings": {
        "foreground": "#4fc3f7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Python - Magic Methods",
      "scope": [
        "support.function.magic.python"
      ],
      "settings": {
        "foreground": "#ff9800"
      }
    },
    {
      "name": "Python - Decorators",
      "scope": [
        "entity.name.function.decorator.python",
        "punctuation.definition.decorator.python"
      ],
      "settings": {
        "foreground": "#ffab40"
      }
    },

    {
      "name": "Java/C# - Annotations",
      "scope": [
        "punctuation.definition.annotation",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#ffab40"
      }
    },
    {
      "name": "Java/C# - Generics",
      "scope": [
        "punctuation.definition.typeparameters",
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#4fc3f7"
      }
    },

    {
      "name": "C/C++ - Preprocessor",
      "scope": [
        "keyword.control.directive",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#4fc3f7"
      }
    },
    {
      "name": "C/C++ - Pointer",
      "scope": [
        "keyword.operator.pointer",
        "keyword.operator.address"
      ],
      "settings": {
        "foreground": "#ff6b9d"
      }
    },

    {
      "name": "Rust - Lifetime",
      "scope": [
        "entity.name.type.lifetime.rust",
        "punctuation.definition.lifetime.rust"
      ],
      "settings": {
        "foreground": "#ff9800"
      }
    },
    {
      "name": "Rust - Macro",
      "scope": [
        "entity.name.function.macro.rust",
        "punctuation.definition.macro.rust"
      ],
      "settings": {
        "foreground": "#4fc3f7"
      }
    },

    {
      "name": "Go - Package",
      "scope": [
        "entity.name.package.go"
      ],
      "settings": {
        "foreground": "#a7ffeb"
      }
    },

    {
      "name": "PHP - Variable",
      "scope": [
        "punctuation.definition.variable.php",
        "variable.other.php"
      ],
      "settings": {
        "foreground": "#e0f2f1"
      }
    },
    {
      "name": "PHP - Namespace",
      "scope": [
        "entity.name.type.namespace.php"
      ],
      "settings": {
        "foreground": "#a7ffeb"
      }
    },

    {
      "name": "HTML - Tag",
      "scope": [
        "entity.name.tag.html",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#4db6ac"
      }
    },
    {
      "name": "HTML - Attribute",
      "scope": [
        "entity.other.attribute-name.html"
      ],
      "settings": {
        "foreground": "#ffab40"
      }
    },
    {
      "name": "HTML - Attribute Value",
      "scope": [
        "string.quoted.double.html",
        "string.quoted.single.html"
      ],
      "settings": {
        "foreground": "#a7ffeb"
      }
    },

    {
      "name": "CSS - Property",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#4fc3f7"
      }
    },
    {
      "name": "CSS - Value",
      "scope": [
        "support.constant.property-value.css",
        "constant.numeric.css"
      ],
      "settings": {
        "foreground": "#a7ffeb"
      }
    },
    {
      "name": "CSS - Selector",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#ffab40"
      }
    },
    {
      "name": "CSS - Units",
      "scope": [
        "keyword.other.unit.css"
      ],
      "settings": {
        "foreground": "#ff9800"
      }
    },

    {
      "name": "JSON - Key Level 0",
      "scope": [
        "source.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#4db6ac",
        "fontStyle": "bold"
      }
    },
    {
      "name": "JSON - Key Level 1",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#80cbc4",
        "fontStyle": "bold"
      }
    },
    {
      "name": "JSON - Key Level 2",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#b2dfdb",
        "fontStyle": "bold"
      }
    },
    {
      "name": "JSON - Punctuation",
      "scope": [
        "punctuation.support.type.property-name.begin.json",
        "punctuation.support.type.property-name.end.json",
        "punctuation.separator.dictionary.key-value.json",
        "punctuation.separator.array.json"
      ],
      "settings": {
        "foreground": "#b2dfdb"
      }
    },
    {
      "name": "JSON - String Value",
      "scope": [
        "string.quoted.double.json",
        "string.quoted.single.json"
      ],
      "settings": {
        "foreground": "#a7ffeb"
      }
    },
    {
      "name": "JSON - Number Value",
      "scope": [
        "constant.numeric.json"
      ],
      "settings": {
        "foreground": "#ffab40"
      }
    },
    {
      "name": "JSON - Boolean Value",
      "scope": [
        "constant.language.json"
      ],
      "settings": {
        "foreground": "#ff6b9d",
        "fontStyle": "bold"
      }
    },
    {
      "name": "JSON - Null Value",
      "scope": [
        "constant.language.null.json"
      ],
      "settings": {
        "foreground": "#f44336",
        "fontStyle": "bold"
      }
    },

    {
      "name": "YAML - Key",
      "scope": [
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#4db6ac"
      }
    },
    {
      "name": "YAML - Value",
      "scope": [
        "string.unquoted.plain.out.yaml"
      ],
      "settings": {
        "foreground": "#a7ffeb"
      }
    },

    {
      "name": "Markdown - Heading",
      "scope": [
        "markup.heading",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#4db6ac",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown - Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#ffab40",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown - Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#4fc3f7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown - Code",
      "scope": [
        "markup.inline.raw.markdown",
        "markup.fenced_code.block.markdown"
      ],
      "settings": {
        "foreground": "#26a69a"
      }
    },
    {
      "name": "Markdown - Link",
      "scope": [
        "markup.underline.link.markdown"
      ],
      "settings": {
        "foreground": "#4fc3f7"
      }
    },
    {
      "name": "Markdown - Quote",
      "scope": [
        "markup.quote.markdown"
      ],
      "settings": {
        "foreground": "#a7ffeb",
        "fontStyle": "italic"
      }
    },

    {
      "name": "SQL - Keyword",
      "scope": [
        "keyword.other.sql"
      ],
      "settings": {
        "foreground": "#4db6ac",
        "fontStyle": "bold"
      }
    },
    {
      "name": "SQL - Function",
      "scope": [
        "support.function.sql"
      ],
      "settings": {
        "foreground": "#26a69a"
      }
    },

    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#b2dfdb"
      }
    },
    {
      "name": "Brackets",
      "scope": [
        "punctuation.section.brackets",
        "punctuation.section.parens",
        "punctuation.section.braces"
      ],
      "settings": {
        "foreground": "#4db6ac"
      }
    },
    {
      "name": "GraphQL Operation",
      "scope": [
        "source.graphql keyword.operation",
        "source.graphql meta.type.interface"
      ],
      "settings": {
        "foreground": "#26c6da",
        "fontStyle": "bold"
      }
    },
    {
      "name": "GraphQL Fields",
      "scope": [
        "source.graphql variable.graphql",
        "source.graphql meta.selection-set"
      ],
      "settings": {
        "foreground": "#80cbc4"
      }
    },
    {
      "name": "Docker Keywords",
      "scope": [
        "keyword.other.special-method.dockerfile",
        "source.dockerfile keyword.operator.flag"
      ],
      "settings": {
        "foreground": "#f48fb1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "YAML Anchors and Aliases",
      "scope": [
        "entity.name.type.anchor.yaml",
        "variable.other.alias.yaml"
      ],
      "settings": {
        "foreground": "#b39ddb",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Shell Variables",
      "scope": [
        "variable.other.special.shell",
        "variable.other.positional.shell",
        "variable.other.normal.shell"
      ],
      "settings": {
        "foreground": "#ce93d8"
      }
    },
    {
      "name": "TypeScript Decorators",
      "scope": [
        "meta.decorator.ts entity.name.function",
        "meta.decorator.tsx entity.name.function"
      ],
      "settings": {
        "foreground": "#dce775",
        "fontStyle": "italic"
      }
    },
    {
      "name": "JSDoc Tags",
      "scope": [
        "comment.block.documentation storage.type.class.jsdoc",
        "comment.block.documentation punctuation.definition.block.tag.jsdoc"
      ],
      "settings": {
        "foreground": "#aed581",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Git Modified",
      "scope": [
        "markup.changed",
        "meta.diff.header.git"
      ],
      "settings": {
        "foreground": "#fff176"
      }
    },
    {
      "name": "Python Decorators",
      "scope": [
        "meta.decorator.python",
        "meta.decorator.identifier.python"
      ],
      "settings": {
        "foreground": "#ffb74d",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Rust Attributes",
      "scope": [
        "meta.attribute.rust",
        "meta.attribute.identifier.rust"
      ],
      "settings": {
        "foreground": "#ff9800",
        "fontStyle": "italic"
      }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "newOperator": "#4db6ac",
    "stringLiteral": "#a7ffeb",
    "numberLiteral": "#ffab40",
    "comment": "#00796b",
    "keyword": "#4db6ac",
    "class": "#ffab40",
    "interface": "#4fc3f7",
    "enum": "#ffab40",
    "typeParameter": "#4fc3f7",
    "function": "#26a69a",
    "method": "#26a69a",
    "property": "#a7ffeb",
