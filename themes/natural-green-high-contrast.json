    },
    {
      "name": "Operator Word",
      "scope": [
        "keyword.operator.word",
        "keyword.operator.typeof",
        "keyword.operator.instanceof"
      ],
      "settings": {
        "foreground": "#00ffff",
        "fontStyle": "bold"
      }
    },

    {
      "name": "Variable",
