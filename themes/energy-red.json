{
  "name": "Energy Red - Passion & Alertness",
  "type": "dark",
  "colors": {
    "editor.background": "#1a0505",
    "editor.foreground": "#ffebee",
    "editorCursor.foreground": "#f44336",
    "editor.lineHighlightBackground": "#b71c1c20",
    "editor.selectionBackground": "#d3280240",
    "activityBar.background": "#2e0707",
    "activityBar.foreground": "#ffcdd2",
    "activityBarBadge.background": "#f44336",
    "sideBar.background": "#330a0a",
    "sideBar.foreground": "#ffcdd2",
    "statusBar.background": "#c62828",
    "statusBar.foreground": "#ffffff",
    "tab.activeBackground": "#1a0505",
    "tab.activeForeground": "#ffebee",
    "tab.inactiveBackground": "#330a0a",
    "tab.activeBorder": "#ef5350",
    "button.background": "#d32f2f",
    "button.hoverBackground": "#f44336",
    "input.background": "#b71c1c30",
    "input.border": "#ef5350",
    "list.activeSelectionBackground": "#d3280240",
    "list.hoverBackground": "#c6282830"
  },
  "tokenColors": [
    {
      "name": "Keyword",
      "scope": ["keyword", "storage.type"],
      "settings": {"foreground": "#ff6b6b", "fontStyle": "bold"}
    },
    {
      "name": "String",
      "scope": ["string"],
      "settings": {"foreground": "#69f0ae"}
    },
    {
      "name": "Function",
      "scope": ["entity.name.function"],
      "settings": {"foreground": "#ff8a65"}
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": {"foreground": "#ffd54f"}
    },
    {
      "name": "Comment",
      "scope": ["comment"],
      "settings": {"foreground": "#ff5252", "fontStyle": "italic"}
    }
  ]
}