{
  "name": "Balance Pink - Compassion & Focus",
  "type": "dark",
  "colors": {
    "editor.background": "#1a0a0f",
    "editor.foreground": "#fce4ec",
    "editorCursor.foreground": "#e91e63",
    "editor.lineHighlightBackground": "#ad14570A",
    "editor.selectionBackground": "#c2185b60",
    "editor.selectionHighlightBackground": "#c2185b20",
    "editor.findMatchBackground": "#ffeb3b40",
    "editor.findMatchHighlightBackground": "#ffeb3b20",
    "editor.wordHighlightBackground": "#e91e6330",
    "editor.wordHighlightStrongBackground": "#e91e6350",
    "editorIndentGuide.background": "#ad145730",
    "editorIndentGuide.activeBackground": "#ec407a",
    "editorLineNumber.foreground": "#c2185b",
    "editorLineNumber.activeForeground": "#f8bbd9",
    "editorGutter.background": "#1a0a0f",
    "editorGutter.modifiedBackground": "#ffeb3b",
    "editorGutter.addedBackground": "#4caf50",
    "editorGutter.deletedBackground": "#f44336",
    
    "editorBracketMatch.background": "#c2185b40",
    "editorBracketMatch.border": "#ec407a",
    "editorBracketHighlight.foreground1": "#ff6b9d",
    "editorBracketHighlight.foreground2": "#4fc3f7",
    "editorBracketHighlight.foreground3": "#81c784",
    "editorBracketHighlight.foreground4": "#ffb74d",
    "editorBracketHighlight.foreground5": "#ba68c8",
    "editorBracketHighlight.foreground6": "#26a69a",

    "activityBar.background": "#2e0714",
    "activityBar.foreground": "#f8bbd9",
    "activityBarBadge.background": "#e91e63",
    "activityBarBadge.foreground": "#eeeeee",

    "sideBar.background": "#330a19",
    "sideBar.foreground": "#f8bbd9",
    "sideBarTitle.foreground": "#ec407a",

    "statusBar.background": "#c2185b",
    "statusBar.foreground": "#eeeeee",
    "statusBar.debuggingBackground": "#f44336",

    "tab.activeBackground": "#1a0a0f",
    "tab.activeForeground": "#fce4ec",
    "tab.inactiveBackground": "#330a19",
    "tab.activeBorder": "#ec407a",

    "terminal.background": "#2a1a1f",
    "terminal.foreground": "#ffeef7",
    "terminal.ansiBlack": "#263238",
    "terminal.ansiRed": "#f44336",
    "terminal.ansiGreen": "#4caf50",
    "terminal.ansiYellow": "#ffeb3b",
    "terminal.ansiBlue": "#2196f3",
    "terminal.ansiMagenta": "#e91e63",
    "terminal.ansiCyan": "#00bcd4",
    "terminal.ansiWhite": "#eceff1",
    "terminal.ansiBrightBlack": "#c2185b",
    "terminal.ansiBrightRed": "#ff5252",
    "terminal.ansiBrightGreen": "#69f0ae",
    "terminal.ansiBrightYellow": "#ffff00",
    "terminal.ansiBrightBlue": "#448aff",
    "terminal.ansiBrightMagenta": "#ff4081",
    "terminal.ansiBrightCyan": "#18ffff",
    "terminal.ansiBrightWhite": "#eeeeee"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "comment.line",
        "comment.block"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#c2185b"
      }
    },
    {
      "name": "Comment Documentation",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#81c784"
      }
    },

    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.other.using",
        "keyword.other.import"
      ],
      "settings": {
        "foreground": "#f06292",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Control Flow Keywords",
      "scope": [
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.exception",
        "keyword.control.trycatch"
      ],
      "settings": {
        "foreground": "#ff4081",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Storage Type",
      "scope": [
        "storage.type",
        "storage.modifier",
        "storage.type.class",
        "storage.type.function",
        "storage.type.interface"
      ],
      "settings": {
        "foreground": "#4fc3f7",
        "fontStyle": "bold"
      }
    },

    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.assignment"
      ],
      "settings": {
        "foreground": "#f8bbd9"
      }
    },
    {
      "name": "Operator Word",
      "scope": [
        "keyword.operator.word",
        "keyword.operator.typeof",
        "keyword.operator.instanceof"
      ],
      "settings": {
        "foreground": "#ff4081"
      }
    },

    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.language.this",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#fce4ec"
      }
    },
    {
      "name": "Variable Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member"
      ],
      "settings": {
        "foreground": "#81c784"
      }
    },
    {
      "name": "Variable Parameter",
      "scope": [
        "variable.parameter",
        "variable.parameter.function"
      ],
      "settings": {
        "foreground": "#ffb74d",
        "fontStyle": "italic"
      }
    },

    {
      "name": "Function Name",
      "scope": [
        "entity.name.function",
        "entity.name.method",
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#f8bbd9"
      }
    },
    {
      "name": "Function Declaration",
      "scope": [
        "meta.function entity.name.function",
        "meta.method entity.name.function"
      ],
      "settings": {
        "foreground": "#e91e63",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Built-in Functions",
      "scope": [
        "support.function.builtin",
        "support.function.magic"
      ],
      "settings": {
        "foreground": "#26a69a"
      }
    },

    {
      "name": "Class Name",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#ffb74d",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Interface Name",
      "scope": [
        "entity.name.interface",
        "entity.name.type.interface"
      ],
      "settings": {
        "foreground": "#4fc3f7",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Type Annotation",
      "scope": [
        "entity.name.type",
        "support.type",
        "meta.type.annotation"
      ],
      "settings": {
        "foreground": "#f8bbd9"
      }
    },

    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.single",
        "string.quoted.double"
      ],
      "settings": {
        "foreground": "#81c784"
      }
    },
    {
      "name": "Template String",
      "scope": [
        "string.template",
        "string.quoted.template"
      ],
      "settings": {
        "foreground": "#a5d6a7"
      }
    },
    {
      "name": "String Interpolation",
      "scope": [
        "string.interpolated",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#4fc3f7"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "string.regex"
      ],
      "settings": {
        "foreground": "#ff9800"
      }
    },

    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.decimal",
        "constant.numeric.hex",
        "constant.numeric.binary",
        "constant.numeric.octal"
      ],
      "settings": {
        "foreground": "#ffb74d"
      }
    },
    {
      "name": "Boolean",
      "scope": [
        "constant.language.boolean",
        "constant.language.true",
        "constant.language.false"
      ],
      "settings": {
        "foreground": "#ff4081",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Null/Undefined",
      "scope": [
        "constant.language.null",
        "constant.language.undefined",
        "constant.language.none"
      ],
      "settings": {
        "foreground": "#f44336",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#ffb74d",
        "fontStyle": "italic"
      }
    },

    
    {
      "name": "JS/TS - Import/Export",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.as"
      ],
      "settings": {
        "foreground": "#4fc3f7"
      }
    },
    {
      "name": "JS/TS - Async/Await",
      "scope": [
        "keyword.control.flow.async",
        "keyword.control.flow.await"
      ],
      "settings": {
        "foreground": "#ff4081",
        "fontStyle": "italic"
      }
    },
    {
      "name": "JS/TS - Destructuring",
      "scope": [
        "meta.object-binding-pattern-variable entity.name.binding",
        "meta.array-binding-pattern-variable entity.name.binding"
      ],
      "settings": {
        "foreground": "#81c784"
      }
    },

    {
      "name": "Python - Self/Cls",
      "scope": [
        "variable.language.special.self.python",
        "variable.language.special.cls.python"
      ],
      "settings": {
        "foreground": "#4fc3f7",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Python - Magic Methods",
      "scope": [
        "support.function.magic.python"
      ],
      "settings": {
        "foreground": "#ff9800"
      }
    },
    {
      "name": "Python - Decorators",
      "scope": [
        "entity.name.function.decorator.python",
        "punctuation.definition.decorator.python"
      ],
      "settings": {
        "foreground": "#ffb74d"
      }
    },

    {
      "name": "Java/C# - Annotations",
      "scope": [
        "punctuation.definition.annotation",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#ffb74d"
      }
    },
    {
      "name": "Java/C# - Generics",
      "scope": [
        "punctuation.definition.typeparameters",
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#4fc3f7"
      }
    },

    {
      "name": "C/C++ - Preprocessor",
      "scope": [
        "keyword.control.directive",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#4fc3f7"
      }
    },
    {
      "name": "C/C++ - Pointer",
      "scope": [
        "keyword.operator.pointer",
        "keyword.operator.address"
      ],
      "settings": {
        "foreground": "#ff4081"
      }
    },

    {
      "name": "Rust - Lifetime",
      "scope": [
        "entity.name.type.lifetime.rust",
        "punctuation.definition.lifetime.rust"
      ],
      "settings": {
        "foreground": "#ff9800"
      }
    },
    {
      "name": "Rust - Macro",
      "scope": [
        "entity.name.function.macro.rust",
        "punctuation.definition.macro.rust"
      ],
      "settings": {
        "foreground": "#4fc3f7"
      }
    },

    {
      "name": "Go - Package",
      "scope": [
        "entity.name.package.go"
      ],
      "settings": {
        "foreground": "#81c784"
      }
    },

    {
      "name": "PHP - Variable",
      "scope": [
        "punctuation.definition.variable.php",
        "variable.other.php"
      ],
      "settings": {
        "foreground": "#fce4ec"
      }
    },
    {
      "name": "PHP - Namespace",
      "scope": [
