{
  "name": "Creative Purple - Innovation & Imagination",
  "type": "dark",
  "colors": {
    "editor.background": "#1a0d1a",
    "editor.foreground": "#f3e5f5",
    "editorCursor.foreground": "#ba68c8",
    "editor.lineHighlightBackground": "#4a148c20",
    "editor.selectionBackground": "#7b1fa240",
    "activityBar.background": "#1e0a1e",
    "activityBar.foreground": "#ce93d8",
    "activityBarBadge.background": "#9c27b0",
    "sideBar.background": "#221122",
    "sideBar.foreground": "#e1bee7",
    "statusBar.background": "#6a1b9a",
    "statusBar.foreground": "#ffffff",
    "tab.activeBackground": "#1a0d1a",
    "tab.activeForeground": "#f3e5f5",
    "tab.inactiveBackground": "#221122",
    "tab.activeBorder": "#ab47bc",
    "button.background": "#8e24aa",
    "button.hoverBackground": "#9c27b0",
    "input.background": "#4a148c30",
    "input.border": "#ab47bc",
    "list.activeSelectionBackground": "#7b1fa240",
    "list.hoverBackground": "#6a1b9a30"
  },
  "tokenColors": [
    {
      "name": "Keyword",
      "scope": ["keyword", "storage.type"],
      "settings": {"foreground": "#ce93d8", "fontStyle": "bold"}
    },
    {
      "name": "String",
      "scope": ["string"],
      "settings": {"foreground": "#a5d6a7"}
    },
    {
      "name": "Function",
      "scope": ["entity.name.function"],
      "settings": {"foreground": "#ba68c8"}
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": {"foreground": "#ffcc02"}
    },
    {
      "name": "Comment",
      "scope": ["comment"],
      "settings": {"foreground": "#8e24aa", "fontStyle": "italic"}
    }
  ]
}