{
  "name": "Neutral Gray - Minimalism & Focus",
  "type": "dark",
  "colors": {
    "editor.background": "#1a1a1a",
    "editor.foreground": "#fafafa",
    "editorCursor.foreground": "#9e9e9e",
    "editor.lineHighlightBackground": "#424242-20",
    "editor.selectionBackground": "#61616140",
    "activityBar.background": "#2e2e2e",
    "activityBar.foreground": "#e0e0e0",
    "activityBarBadge.background": "#757575",
    "sideBar.background": "#333333",
    "sideBar.foreground": "#e0e0e0",
    "statusBar.background": "#616161",
    "statusBar.foreground": "#ffffff",
    "tab.activeBackground": "#1a1a1a",
    "tab.activeForeground": "#fafafa",
    "tab.inactiveBackground": "#333333",
    "tab.activeBorder": "#bdbdbd",
    "button.background": "#757575",
    "button.hoverBackground": "#9e9e9e",
    "input.background": "#42424230",
    "input.border": "#bdbdbd",
    "list.activeSelectionBackground": "#61616140",
    "list.hoverBackground": "#61616130"
  },
  "tokenColors": [
    {
      "name": "Keyword",
      "scope": ["keyword", "storage.type"],
      "settings": {"foreground": "#e0e0e0", "fontStyle": "bold"}
    },
    {
      "name": "String",
      "scope": ["string"],
      "settings": {"foreground": "#c8e6c9"}
    },
    {
      "name": "Function",
      "scope": ["entity.name.function"],
      "settings": {"foreground": "#f5f5f5"}
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": {"foreground": "#ffecb3"}
    },
    {
      "name": "Comment",
      "scope": ["comment"],
      "settings": {"foreground": "#9e9e9e", "fontStyle": "italic"}
    }
  ]
}