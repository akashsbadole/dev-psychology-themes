{
  "name": "Focus Blue - Concentration & Trust",
  "type": "dark",
  "colors": {
    "editor.background": "#0a0e1a",
    "editor.foreground": "#e8f4f8",
    "editorCursor.foreground": "#64b5f6",
    "editor.lineHighlightBackground": "#1a237e15",
    "editor.selectionBackground": "#1976d240",
    "editor.selectionHighlightBackground": "#1976d220",
    "editor.findMatchBackground": "#ffeb3b40",
    "editor.findMatchHighlightBackground": "#ffeb3b20",
    "editor.wordHighlightBackground": "#2196f330",
    "editor.wordHighlightStrongBackground": "#2196f350",
    "editorIndentGuide.background": "#1a237e30",
    "editorIndentGuide.activeBackground": "#42a5f5",
    "editorLineNumber.foreground": "#546e7a",
    "editorLineNumber.activeForeground": "#90caf9",
    "editorGutter.background": "#0a0e1a",
    "editorGutter.modifiedBackground": "#ffeb3b",
    "editorGutter.addedBackground": "#4caf50",
    "editorGutter.deletedBackground": "#f44336",
    
    "editorBracketMatch.background": "#1976d240",
    "editorBracketMatch.border": "#42a5f5",
    "editorBracketHighlight.foreground1": "#ff6b9d",
    "editorBracketHighlight.foreground2": "#4fc3f7",
    "editorBracketHighlight.foreground3": "#81c784",
    "editorBracketHighlight.foreground4": "#ffb74d",
    "editorBracketHighlight.foreground5": "#ba68c8",
    "editorBracketHighlight.foreground6": "#26a69a",

    "activityBar.background": "#0d1421",
    "activityBar.foreground": "#90caf9",
    "activityBarBadge.background": "#2196f3",
    "activityBarBadge.foreground": "#ffffff",

    "sideBar.background": "#0f1419",
    "sideBar.foreground": "#bbdefb",
    "sideBarTitle.foreground": "#42a5f5",

    "statusBar.background": "#1565c0",
    "statusBar.foreground": "#ffffff",
    "statusBar.debuggingBackground": "#f44336",

    "tab.activeBackground": "#0a0e1a",
    "tab.activeForeground": "#e3f2fd",
    "tab.inactiveBackground": "#0f1419",
    "tab.activeBorder": "#42a5f5",

    "terminal.background": "#0a0e1a",
    "terminal.foreground": "#e8f4f8",
    "terminal.ansiBlack": "#263238",
    "terminal.ansiRed": "#f44336",
    "terminal.ansiGreen": "#4caf50",
    "terminal.ansiYellow": "#ffeb3b",
    "terminal.ansiBlue": "#2196f3",
    "terminal.ansiMagenta": "#e91e63",
    "terminal.ansiCyan": "#00bcd4",
    "terminal.ansiWhite": "#eceff1",
    "terminal.ansiBrightBlack": "#546e7a",
    "terminal.ansiBrightRed": "#ff5252",
    "terminal.ansiBrightGreen": "#69f0ae",
    "terminal.ansiBrightYellow": "#ffff00",
    "terminal.ansiBrightBlue": "#448aff",
    "terminal.ansiBrightMagenta": "#ff4081",
    "terminal.ansiBrightCyan": "#18ffff",
    "terminal.ansiBrightWhite": "#ffffff"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "comment.line",
        "comment.block"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#546e7a"
      }
    },
    {
      "name": "Comment Documentation",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "fontStyle": "italic",
        "foreground": "#81c784"
      }
    },

    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator.new",
        "keyword.other.using",
        "keyword.other.import"
      ],
      "settings": {
        "foreground": "#64b5f6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Control Flow Keywords",
      "scope": [
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.exception",
        "keyword.control.trycatch"
      ],
      "settings": {
        "foreground": "#ff6b9d",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Storage Type",
      "scope": [
        "storage.type",
        "storage.modifier",
        "storage.type.class",
        "storage.type.function",
        "storage.type.interface"
      ],
      "settings": {
        "foreground": "#ba68c8",
        "fontStyle": "bold"
      }
    },

    {
      "name": "Operator",
      "scope": [
        "keyword.operator",
        "keyword.operator.arithmetic",
        "keyword.operator.comparison",
        "keyword.operator.logical",
        "keyword.operator.assignment"
      ],
      "settings": {
        "foreground": "#4fc3f7"
      }
    },
    {
      "name": "Operator Word",
      "scope": [
        "keyword.operator.word",
        "keyword.operator.typeof",
        "keyword.operator.instanceof"
      ],
      "settings": {
        "foreground": "#ff6b9d"
      }
    },

    {
      "name": "Variable",
      "scope": [
        "variable",
        "variable.other",
        "variable.language.this",
        "variable.language.super"
      ],
      "settings": {
        "foreground": "#e8f4f8"
      }
    },
    {
      "name": "Variable Property",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.other.member"
      ],
      "settings": {
        "foreground": "#81c784"
      }
    },
    {
      "name": "Variable Parameter",
      "scope": [
        "variable.parameter",
        "variable.parameter.function"
      ],
      "settings": {
        "foreground": "#ffb74d",
        "fontStyle": "italic"
      }
    },

    {
      "name": "Function Name",
      "scope": [
        "entity.name.function",
        "entity.name.method",
        "meta.function-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#90caf9"
      }
    },
    {
      "name": "Function Declaration",
      "scope": [
        "meta.function entity.name.function",
        "meta.method entity.name.function"
      ],
      "settings": {
        "foreground": "#42a5f5",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Built-in Functions",
      "scope": [
        "support.function.builtin",
        "support.function.magic"
      ],
      "settings": {
        "foreground": "#26a69a"
      }
    },

    {
      "name": "Class Name",
      "scope": [
        "entity.name.class",
        "entity.name.type.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#ffb74d",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Interface Name",
      "scope": [
        "entity.name.interface",
        "entity.name.type.interface"
      ],
      "settings": {
        "foreground": "#ba68c8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Type Annotation",
      "scope": [
        "entity.name.type",
        "support.type",
        "meta.type.annotation"
      ],
      "settings": {
        "foreground": "#4fc3f7"
      }
    },

    {
      "name": "String",
      "scope": [
        "string",
        "string.quoted",
        "string.quoted.single",
        "string.quoted.double"
      ],
      "settings": {
        "foreground": "#81c784"
      }
    },
    {
      "name": "Template String",
      "scope": [
        "string.template",
        "string.quoted.template"
      ],
      "settings": {
        "foreground": "#a5d6a7"
      }
    },
    {
      "name": "String Interpolation",
      "scope": [
        "string.interpolated",
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#4fc3f7"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "string.regex"
      ],
      "settings": {
        "foreground": "#ff9800"
      }
    },

    {
      "name": "Number",
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float",
        "constant.numeric.decimal",
        "constant.numeric.hex",
        "constant.numeric.binary",
        "constant.numeric.octal"
      ],
      "settings": {
        "foreground": "#ffb74d"
      }
    },
    {
      "name": "Boolean",
      "scope": [
        "constant.language.boolean",
        "constant.language.true",
        "constant.language.false"
      ],
      "settings": {
        "foreground": "#ff6b9d",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Null/Undefined",
      "scope": [
        "constant.language.null",
        "constant.language.undefined",
        "constant.language.none"
      ],
      "settings": {
        "foreground": "#f44336",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Constant",
      "scope": [
        "constant.other",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#ffb74d",
        "fontStyle": "italic"
      }
    },


    {
      "name": "JS/TS - Import/Export",
      "scope": [
        "keyword.control.import",
        "keyword.control.export",
        "keyword.control.from",
        "keyword.control.as"
      ],
      "settings": {
        "foreground": "#ba68c8"
      }
    },
    {
      "name": "JS/TS - Async/Await",
      "scope": [
        "keyword.control.flow.async",
        "keyword.control.flow.await"
      ],
      "settings": {
        "foreground": "#ff6b9d",
        "fontStyle": "italic"
      }
    },
    {
      "name": "JS/TS - Destructuring",
      "scope": [
        "meta.object-binding-pattern-variable entity.name.binding",
        "meta.array-binding-pattern-variable entity.name.binding"
      ],
      "settings": {
        "foreground": "#81c784"
      }
    },

    {
      "name": "Python - Self/Cls",
      "scope": [
        "variable.language.special.self.python",
        "variable.language.special.cls.python"
      ],
      "settings": {
        "foreground": "#ba68c8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Python - Magic Methods",
      "scope": [
        "support.function.magic.python"
      ],
      "settings": {
        "foreground": "#ff9800"
      }
    },
    {
      "name": "Python - Decorators",
      "scope": [
        "entity.name.function.decorator.python",
        "punctuation.definition.decorator.python"
      ],
      "settings": {
        "foreground": "#ffb74d"
      }
    },

    {
      "name": "Java/C# - Annotations",
      "scope": [
        "punctuation.definition.annotation",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#ffb74d"
      }
    },
    {
      "name": "Java/C# - Generics",
      "scope": [
        "punctuation.definition.typeparameters",
        "entity.name.type.parameter"
      ],
      "settings": {
        "foreground": "#4fc3f7"
      }
    },

    {
      "name": "C/C++ - Preprocessor",
      "scope": [
        "keyword.control.directive",
        "meta.preprocessor"
      ],
      "settings": {
        "foreground": "#ba68c8"
      }
    },
    {
      "name": "C/C++ - Pointer",
      "scope": [
        "keyword.operator.pointer",
        "keyword.operator.address"
      ],
      "settings": {
        "foreground": "#ff6b9d"
      }
    },

    {
      "name": "Rust - Lifetime",
      "scope": [
        "entity.name.type.lifetime.rust",
        "punctuation.definition.lifetime.rust"
      ],
      "settings": {
        "foreground": "#ff9800"
      }
    },
    {
      "name": "Rust - Macro",
      "scope": [
        "entity.name.function.macro.rust",
        "punctuation.definition.macro.rust"
      ],
      "settings": {
        "foreground": "#ba68c8"
      }
    },

    {
      "name": "Go - Package",
      "scope": [
        "entity.name.package.go"
      ],
      "settings": {
        "foreground": "#81c784"
      }
    },

    {
      "name": "PHP - Variable",
      "scope": [
        "punctuation.definition.variable.php",
        "variable.other.php"
      ],
      "settings": {
        "foreground": "#e8f4f8"
      }
    },
    {
      "name": "PHP - Namespace",
      "scope": [
        "entity.name.type.namespace.php"
      ],
      "settings": {
        "foreground": "#81c784"
      }
    },

    {
      "name": "HTML - Tag",
      "scope": [
        "entity.name.tag.html",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#64b5f6"
      }
    },
    {
      "name": "HTML - Attribute",
      "scope": [
        "entity.other.attribute-name.html"
      ],
      "settings": {
        "foreground": "#ffb74d"
      }
    },
    {
      "name": "HTML - Attribute Value",
      "scope": [
        "string.quoted.double.html",
        "string.quoted.single.html"
      ],
      "settings": {
        "foreground": "#81c784"
      }
    },

    {
      "name": "CSS - Property",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#4fc3f7"
      }
    },
    {
      "name": "CSS - Value",
      "scope": [
        "support.constant.property-value.css",
        "constant.numeric.css"
      ],
      "settings": {
        "foreground": "#81c784"
      }
    },
    {
      "name": "CSS - Selector",
      "scope": [
        "entity.name.tag.css",
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#ffb74d"
      }
    },
    {
      "name": "CSS - Units",
      "scope": [
        "keyword.other.unit.css"
      ],
      "settings": {
        "foreground": "#ff9800"
      }
    },

    {
      "name": "JSON - Key Level 0",
      "scope": [
        "source.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#64b5f6"
      }
    },
    {
      "name": "JSON - Key Level 1",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#ba68c8"
      }
    },
    {
      "name": "JSON - Key Level 2",
      "scope": [
        "source.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json meta.structure.dictionary.value.json meta.structure.dictionary.json support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#4fc3f7"
      }
    },

  
    {
      "name": "YAML - Key",
      "scope": [
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#64b5f6"
      }
    },
    {
      "name": "YAML - Value",
      "scope": [
        "string.unquoted.plain.out.yaml"
      ],
      "settings": {
        "foreground": "#81c784"
      }
    },

    {
      "name": "Markdown - Heading",
      "scope": [
        "markup.heading",
        "punctuation.definition.heading.markdown"
      ],
      "settings": {
        "foreground": "#64b5f6",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown - Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#ffb74d",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown - Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#ba68c8",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown - Code",
      "scope": [
        "markup.inline.raw.markdown",
